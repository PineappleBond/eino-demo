# Eino Demo Development Environment Variables
# This file is a template for local development configuration.
# Copy to .env and customize as needed.

# PostgreSQL Configuration
POSTGRES_USER=eino-demo
POSTGRES_PASSWORD=admin123
POSTGRES_DB=eino_demo

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# Ollama Configuration
OLLAMA_HOST=0.0.0.0
OLLAMA_MODELS=mxbai-embed-large

# Notes:
# - These values are for local development only
# - In production, use strong passwords and secure configuration
# - The docker-compose.yaml uses hardcoded values from this template
